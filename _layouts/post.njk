---
layout: base.njk
---
<main id="main-content">
  <article class="post-wrap">
    <header class="post-header">
      <a href="/{% if lang == 'en' %}en/{% endif %}blog/" class="post-back">
        <span class="material-symbols-rounded" aria-hidden="true" data-icon="arrow_back"></span>
        {{ site.back_to_articles[lang] }}
      </a>
      <h1 class="post-title">{{ title }}</h1>
      <time class="post-date" datetime="{{ date | dateISO }}">
        {{ site.published_on[lang] }} {{ date | readableDate(lang) }}
      </time>
    </header>
    <div class="post-body">
      {{ content | safe }}
    </div>
  </article>
</main>
