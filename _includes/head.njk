<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large">
  <title>{{ site.title[lang] }}</title>
  <meta name="description" content="{{ site.description[lang] }}">
  <meta name="keywords" content="{{ site.keywords[lang] }}">
  <meta name="theme-color" content="#006874">

  <!-- Canonical + hreflang -->
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="{{ lang }}" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="{{ site.altlang[lang] }}" href="{{ site.url }}/{{ site.altpath[lang] }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}/">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:locale" content="{% if lang == 'fr' %}fr_FR{% else %}en_GB{% endif %}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ site.title[lang] }}">
  <meta property="og:description" content="{{ site.description[lang] }}">
  <meta property="og:image" content="{{ site.url }}/img/caducee-masseurkine-profile.webp">
  <meta property="og:image:width" content="400">
  <meta property="og:image:height" content="400">
  <meta property="og:site_name" content="Kine Val Fleury">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ site.title[lang] }}">
  <meta name="twitter:description" content="{{ site.description[lang] }}">
  <meta name="twitter:image" content="{{ site.url }}/img/caducee-masseurkine-profile.webp">

  <!-- Icons + PWA -->
  <link rel="shortcut icon" href="/img/favicon.png">
  <link rel="apple-touch-icon" sizes="192x192" href="/img/caducee-192.png">
  <link rel="manifest" href="{{ site.manifest[lang] }}">

  <!-- Critical resource hints -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://www.googletagmanager.com">
  <link rel="preload" as="image" href="/img/bg-banner.webp" fetchpriority="high">

  <style>{% inlineCSS %}</style>

  <!-- Material Symbols — loaded async to avoid render blocking -->
  <link rel="preload"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
        as="style"
        onload="this.onload=null;this.rel='stylesheet'">
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
          rel="stylesheet">
  </noscript>

  <!-- Structured data: MedicalBusiness (more specific than LocalBusiness) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    "@id": "{{ site.url }}/#practice",
    "url": "{{ site.url }}/",
    "name": "Cabinet de Kinésithérapie & Ostéopathie Almajan",
    "description": "Cabinet de kinésithérapie et d'ostéopathie à Meudon (Val Fleury). Andreea Almajan, Kinésithérapeute D.E. et Ostéopathe D.O., vous reçoit au 10 Avenue Louvois, à deux minutes à pied de la gare RER C Val Fleury.",
    "logo": "{{ site.url }}/img/caducee-masseurkine.webp",
    "image": [
      "{{ site.url }}/img/waitingroom.webp",
      "{{ site.url }}/img/salle1.webp",
      "{{ site.url }}/img/salle2.webp",
      "{{ site.url }}/img/salle3.webp"
    ],
    "telephone": "+33145342973",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "10 Avenue Louvois",
      "addressLocality": "Meudon",
      "addressRegion": "Hauts-de-Seine",
      "postalCode": "92190",
      "addressCountry": "FR"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "48.8076047",
      "longitude": "2.2399007"
    },
    "hasMap": "https://www.openstreetmap.org/?mlat=48.8076329&mlon=2.2399007#map=17/48.8076329/2.2399007",
    "medicalSpecialty": "https://schema.org/PhysicalTherapy",
    "areaServed": [
      { "@type": "City", "name": "Meudon" },
      { "@type": "City", "name": "Issy-les-Moulineaux" },
      { "@type": "City", "name": "Clamart" }
    ],
    "employee": {
      "@type": "Person",
      "name": "Andreea Almajan",
      "jobTitle": "Kinésithérapeute D.E., Ostéopathe D.O."
    }
  }
  </script>

  <!-- Google Analytics — loaded after page to keep it off the critical path -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ site.ga4_id }}');
    window.addEventListener('load', function() {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id={{ site.ga4_id }}';
      document.head.appendChild(s);
    });
  </script>
</head>
